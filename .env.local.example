# Copy to .env.local and fill in your actual values
# See ENV_SETUP.md for detailed instructions

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Google Calendar OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# TrainingPeaks OAuth
TRAININGPEAKS_CLIENT_ID=your-trainingpeaks-client-id
TRAININGPEAKS_REDIRECT_URI=http://localhost:3000/api/trainingpeaks/callback

# Outlook OAuth
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/outlook/callback

# Optional for direct DB tools or supabase CLI:
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
