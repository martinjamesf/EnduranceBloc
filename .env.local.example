# Supabase Configuration
# Get these values from https://app.supabase.com → Project Settings → API

# Required for client-side authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Required for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Database connection string for migrations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Google Analytics (optional)
# Create a GA4 property at https://analytics.google.com/
# Get the Measurement ID from Admin → Property → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# TrainingPeaks OAuth (optional)
TRAININGPEAKS_CLIENT_ID=your-trainingpeaks-client-id
TRAININGPEAKS_CLIENT_SECRET=your-trainingpeaks-client-secret
TRAININGPEAKS_REDIRECT_URI=http://localhost:3000/api/trainingpeaks/callback

# Microsoft Outlook OAuth (optional)
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/outlook/callback
